# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Postgres local (docker compose) ---
# Contraseñas solo para desarrollo local.
POSTGRES_PASSWORD=change_me_local_postgres
APP_DB_PASSWORD=change_me_local_runtime

# La app se conecta con un rol SIN privilegios de dueño, para que apliquen las políticas RLS.
DATABASE_URL=postgres://zenith_runtime:change_me_local_runtime@localhost:5433/zenith
# Las migraciones se ejecutan con el rol dueño del esquema.
MIGRATION_DATABASE_URL=postgres://postgres:change_me_local_postgres@localhost:5433/zenith

# --- Redis local ---
REDIS_URL=redis://localhost:6380

# --- Meta (WhatsApp Cloud API) ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Versión de Graph API fijada a propósito (ej. v21.0). Confirmar la vigente en developers.facebook.com.
META_GRAPH_API_VERSION=

# --- Cifrado de credenciales por tenant ---
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=
ENCRYPTION_MASTER_KEY_ID=local-1

# --- IA ---
# none: sin IA (cada mensaje recibe el respaldo y pasa a un asesor).
# gemini: API de Google (clave en https://aistudio.google.com). En la capa GRATUITA Google puede usar y
#   revisar lo enviado y pide no mandar datos personales: úsala solo con el simulador y datos ficticios.
# openai-compatible: cualquier API con formato de OpenAI (Ollama, OpenRouter…): AI_BASE_URL + AI_MODEL.
# anthropic: Claude. Su política de regiones no incluye a Venezuela.
# Antes de usar un proveedor con clientes reales, revisa que su política de regiones y de datos lo permita.
AI_PROVIDER=none
GEMINI_API_KEY=
AI_BASE_URL=
AI_API_KEY=
ANTHROPIC_API_KEY=
# Si se deja vacío: gemini-3.8-flash (gemini) o claude-opus-5-5 (anthropic).
AI_MODEL=
# low | medium | high. medium es el valor por defecto del modelo.
AI_EFFORT=medium

# --- Catálogo de Inversiones Mora Mora ---
IMM_STORE_BASE_URL=https://inversionesmoramora.com
# Catálogo de Cerámica Italia que importa ZenithVisualizer: agrega aspecto (madera, mármol…), color y colección.
CI_CATALOG_PATH=C:/GrupoZenith/ZenithVisualizer/data/catalog/ceramica_italia/catalog.json

# --- Solo desarrollo local ---
# phone_number_id y token del número de prueba de Meta, para npm run db:seed-dev.
# El token se guarda cifrado en la BD con ENCRYPTION_MASTER_KEY.
DEV_WHATSAPP_PHONE_NUMBER_ID=
DEV_WHATSAPP_ACCESS_TOKEN=
# Id de la cuenta de WhatsApp Business (WABA) del número: ubica los avisos de desconexión.
DEV_WHATSAPP_WABA_ID=
# Apunta los envíos a un simulador local en vez de Meta (ej. http://localhost:4010). Dejar vacío en producción.
META_GRAPH_BASE_URL=
# Pruebas de integración (si faltan, esas pruebas se saltan). Pueden apuntar a la misma BD local.
TEST_DATABASE_URL=postgres://zenith_runtime:change_me_local_runtime@localhost:5433/zenith
TEST_MIGRATION_DATABASE_URL=postgres://postgres:change_me_local_postgres@localhost:5433/zenith

# --- Panel de asesores ---
API_PORT=3100
# true cuando el panel se sirve por https (producción).
COOKIE_SECURE=false
# URL del panel que va en los correos de aviso.
PANEL_URL=http://localhost:5180
# Correo para avisar a los asesores. Sin SMTP_HOST, el aviso solo queda en el log del worker.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Usuario del panel que crea npm run db:seed-dev (solo desarrollo; contraseña de al menos 10 caracteres).
DEV_PANEL_EMAIL=
DEV_PANEL_PASSWORD=

# --- Simulador local (npm run dev:sim) ---
# Para usarlo, el worker debe correr con META_GRAPH_BASE_URL=http://localhost:4010
SIMULATOR_PORT=4010
SIMULATOR_GATEWAY_URL=http://localhost:3000

# --- Procesos ---
GATEWAY_PORT=3000
LOG_LEVEL=info

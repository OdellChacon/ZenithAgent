# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Postgres local (docker compose) ---
# Contraseñas solo para desarrollo local.
POSTGRES_PASSWORD=change_me_local_postgres
APP_DB_PASSWORD=change_me_local_runtime

# La app se conecta con un rol SIN privilegios de dueño, para que apliquen las políticas RLS.
DATABASE_URL=postgres://zenith_runtime:change_me_local_runtime@localhost:5433/zenith
# Las migraciones se ejecutan con el rol dueño del esquema.
MIGRATION_DATABASE_URL=postgres://postgres:change_me_local_postgres@localhost:5433/zenith

# --- Redis local ---
REDIS_URL=redis://localhost:6380

# --- Meta (WhatsApp Cloud API) ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Versión de Graph API fijada a propósito (ej. v21.0). Confirmar la vigente en developers.facebook.com.
META_GRAPH_API_VERSION=

# --- Cifrado de credenciales por tenant ---
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=
ENCRYPTION_MASTER_KEY_ID=local-1

# --- Catálogo de Inversiones Mora Mora ---
IMM_STORE_BASE_URL=https://inversionesmoramora.com

# --- Solo desarrollo local ---
# phone_number_id del número de prueba de Meta, para npm run db:seed-dev.
DEV_WHATSAPP_PHONE_NUMBER_ID=
# Pruebas de integración (si faltan, esas pruebas se saltan). Pueden apuntar a la misma BD local.
TEST_DATABASE_URL=postgres://zenith_runtime:change_me_local_runtime@localhost:5433/zenith
TEST_MIGRATION_DATABASE_URL=postgres://postgres:change_me_local_postgres@localhost:5433/zenith

# --- Procesos ---
GATEWAY_PORT=3000
LOG_LEVEL=info

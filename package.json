{
  "name": "zenith-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/panel/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "db:migrate": "tsx --env-file=.env packages/db/src/cli/migrate.ts",
    "db:seed-dev": "tsx --env-file=.env packages/db/src/cli/seed-dev.ts",
    "catalog:sync-imm": "tsx --env-file=.env packages/catalog/src/cli/sync-imm.ts",
    "catalog:describe": "tsx --env-file=.env apps/worker/src/cli/describe-catalog.ts",
    "dev:gateway": "tsx watch --env-file=.env apps/gateway/src/index.ts",
    "dev:worker": "tsx watch --env-file=.env apps/worker/src/index.ts",
    "dev:sim": "tsx watch --env-file=.env apps/simulator/src/index.ts",
    "dev:api": "tsx watch --env-file=.env apps/api/src/index.ts",
    "dev:panel": "npm run dev -w @zenith/panel",
    "build:panel": "npm run build -w @zenith/panel",
    "user:create": "tsx --env-file=.env apps/api/src/cli/create-user.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}

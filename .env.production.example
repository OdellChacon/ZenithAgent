# Producción (docker-compose.prod.yml). Copiar a .env.production EN EL SERVIDOR y completar.
# Nunca subir .env.production al repositorio. Ver docs/despliegue.md.

# --- Dominio (https automático con Let's Encrypt) ---
# Subdominio que apunta a la IP del servidor (registro A), ej. bot.inversionesmoramora.com.
DOMAIN=
# Correo para los avisos de Let's Encrypt sobre el certificado.
ACME_EMAIL=
TZ=America/Caracas

# --- Base de datos (dentro de Docker; no se publica) ---
# La app entra con el rol zenith_runtime (sujeto al aislamiento por negocio). <clave> es la misma
# APP_DB_PASSWORD de .env.db. La contraseña del superusuario NO va en este archivo.
DATABASE_URL=postgres://zenith_runtime:<clave>@postgres:5432/zenith
# Copias diarias en ./backups: hora local y días que se guardan.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# --- Meta ---
META_APP_ID=
META_APP_SECRET=
# Al menos 16 caracteres al azar; el mismo que se pone en la configuración del webhook en Meta.
META_WEBHOOK_VERIFY_TOKEN=
META_ES_CONFIG_ID=
# Versión fijada de Graph API (ej. v27.0); confirmar la vigente en developers.facebook.com.
META_GRAPH_API_VERSION=
# Vacío en producción (solo se usa con el simulador local).
META_GRAPH_BASE_URL=

# --- Cifrado de los tokens de cada canal ---
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guardar una copia fuera del servidor: sin esta clave, los tokens guardados no se pueden leer.
ENCRYPTION_MASTER_KEY=
ENCRYPTION_MASTER_KEY_ID=prod-1

# --- IA (capa de pago: Google no usa los datos) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=
AI_EFFORT=medium
AI_AUDIO=false

# --- Panel y avisos por correo ---
PANEL_URL=https://
# Servidor de correo saliente (ver docs/despliegue.md, sección Correo). Sin SMTP_HOST, los
# avisos a los asesores solo quedan en el log. Probar con: npm run mail:test (ver la guía).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Catálogo de la tienda ---
IMM_STORE_BASE_URL=https://inversionesmoramora.com

# --- Procesos ---
LOG_LEVEL=info
WORKER_CONCURRENCY=8

# Contraseñas de la base de datos (docker-compose.prod.yml). Copiar a .env.db EN EL SERVIDOR.
# Solo lo leen los servicios postgres, migrate y backup: la app no recibe la del superusuario.
# Nunca subir .env.db al repositorio. chmod 600 .env.db
#
# Solo letras y números (van dentro de una URL). Generar cada una con: openssl rand -hex 32

# Superusuario "postgres": migraciones, copias y comandos de administración.
POSTGRES_PASSWORD=
# Rol zenith_runtime que usa la app; repetir esta misma clave en DATABASE_URL de .env.production.
APP_DB_PASSWORD=
